## Visual Studio C# .gitignore (özet)

# Derleme çıktıları
bin/
obj/
out/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
publish/

# Visual Studio ayarları ve kullanıcıya özel dosyalar
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Test sonuçları
TestResults/
[Tt]est[Rr]esult*/

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# ReSharper ve Rider
_ReSharper*/
*.[Rr]e[Ss]harper
.idea/
*.DotSettings.user

# Diğer
*.log
*.tmp
*.cache
